{
  "name": "interactive-learning-platform",
  "version": "1.4.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --no-warnings scripts/audit-rules.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint",
    "test": "node --no-warnings --test tests/*.test.ts",
    "audit:rules": "node --no-warnings scripts/audit-rules.ts",
    "audit:comprehensive": "node --no-warnings scripts/audit-comprehensive.ts",
    "audit": "node --no-warnings scripts/audit-rules.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-simple-code-editor": "^0.14.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7"
  },
  "overrides": {
    "eslint-config-next": {
      "eslint-plugin-react": {
        "eslint": "$eslint"
      },
      "eslint-plugin-import": {
        "eslint": "$eslint"
      },
      "eslint-plugin-jsx-a11y": {
        "eslint": "$eslint"
      }
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "description": "Webbasierte Open-Source-Lernplattform für interaktive Schulaufgaben, Probetests und Programmierung."
}
