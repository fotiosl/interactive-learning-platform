# Admin Passwort für den Demo-Lehrermodus (Hauptseite /)
# Standard-Passwort für die lokale Entwicklung: demo2026
ADMIN_PASSWORD=demo2026

# Geheimer HMAC-Schlüssel für die Signatur des Session-Cookies (in Produktion unbedingt setzen!)
AUTH_SECRET=change-this-to-a-long-random-secret

# Optional: Java-Ausführung auf dem Server
# 'sandbox' = externe Piston-Sandbox verwenden, 'interpreter' = Client-WebWorker erzwingen
# JAVA_RUNNER_MODE=interpreter
# JAVA_SANDBOX_URL=http://localhost:2000/api/v2/execute
# NEXT_PUBLIC_USE_JAVA_SERVER=true
